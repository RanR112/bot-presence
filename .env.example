# Bot Token yang SAMA seperti yang dipakai project notifier utama.
# Boleh pakai token yang sama karena ini cuma menjaga koneksi Online --
# tidak melakukan aksi apa pun yang bisa bentrok dengan proses lain.
DISCORD_BOT_TOKEN=

# Opsional -- teks yang muncul di bawah nama bot di daftar member,
# mis. "TikTok LIVE & content notifier". Kosongkan untuk tidak menampilkan apa pun.
PRESENCE_TEXT=

# Opsional -- emoji unicode di depan teks status (mis. 🔥 atau 🔊). Butuh
# PRESENCE_TEXT terisi, kosong = tidak ada emoji.
PRESENCE_EMOJI=
