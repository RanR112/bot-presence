# Bot Token yang SAMA seperti yang dipakai project notifier utama.
DISCORD_BOT_TOKEN=

# Opsional -- teks yang muncul di bawah nama bot di daftar member.
PRESENCE_TEXT=
# Opsional -- emoji unicode di depan teks status. Butuh PRESENCE_TEXT terisi.
PRESENCE_EMOJI=

# === Gift leaderboard (TikTok coin) ===
# Ketiganya harus terisi supaya fitur leaderboard aktif.
DISCORD_GUILD_ID=
TIKTOK_USERNAME=
GIFT_LEADERBOARD_CHANNEL_ID=

# Berapa menit sekali papan leaderboard diperbarui saat LIVE berlangsung.
LEADERBOARD_UPDATE_MINUTES=5
# Berapa nama yang ditampilkan per kategori.
LEADERBOARD_TOP_COUNT=10
# Jeda cek "apakah sudah LIVE" saat streamer sedang offline (detik).
TIKTOK_LIVE_POLL_SECONDS=60

# === Saweria leaderboard ===
# Beda dari gift coin TikTok: hanya all-time, nama saja tanpa nominal, tidak
# ada role/milestone. Keduanya harus terisi supaya fitur ini aktif.
# Channel TERPISAH dari GIFT_LEADERBOARD_CHANNEL_ID di atas.
SAWERIA_LEADERBOARD_CHANNEL_ID=
# Ambil dari URL widget leaderboard di dashboard Saweria (bagian "Stream Alert"
# / "Widget"), contoh: https://saweria.co/widgets/leaderboard?streamKey=INI
# JANGAN dibagikan/commit -- nilai ini setara kredensial ke data donasi.
SAWERIA_STREAM_KEY=
# Diperbarui terus-menerus (tidak terikat LIVE, beda dari gift coin TikTok).
# 15 menit terlalu sering kena 429 dari Cloudflare -- 30 menit lebih aman.
SAWERIA_UPDATE_MINUTES=30
SAWERIA_TOP_COUNT=10

# === Fan Club leaderboard ===
# Level Fan Club diset manual oleh moderator (>setfanclublevel), bukan
# diamati otomatis -- jadi papan ini diperbarui instan tiap ada perubahan,
# tidak butuh interval berkala. Cukup isi channel ID untuk mengaktifkan.
FANCLUB_LEADERBOARD_CHANNEL_ID=
FANCLUB_TOP_COUNT=10

# === Tiket verifikasi ===
# MOD_ROLE_ID dan MOD_NOTIFY_CHANNEL_ID harus terisi supaya fitur tiket aktif.
MOD_ROLE_ID=
MOD_NOTIFY_CHANNEL_ID=
# Opsional -- kategori tempat channel tiket dibuat.
TICKET_CATEGORY_ID=
# Discord tidak menyediakan status "sudah dibaca" untuk bot, jadi tiket ditutup
# sekian jam setelah moderator memutuskan.
TICKET_CLOSE_AFTER_HOURS=24

# === Opsional ===
# Channel pengumuman saat member naik tingkat milestone.
LEVELUP_CHANNEL_ID=
COMMAND_PREFIX=>
TIMEZONE=Asia/Jakarta
